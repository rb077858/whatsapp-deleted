rules_version = '2';
// The bot (on the phone) uses a service account and bypasses these rules.
// Visitors don't sign in: each request is a document with a random id that only its creator knows.
// Documents can be read one at a time by id, never listed.
service cloud.firestore {
  match /databases/{database}/documents {
    function newRequest(keys) {
      return request.resource.data.uid is string
        && request.resource.data.uid.size() <= 64
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(keys);
    }

    match /rpc/{id} {
      allow create: if newRequest(['uid', 'status', 'op', 'args', 'token', 'createdAt'])
        && request.resource.data.op is string && request.resource.data.args is map;
      allow get: if true;
    }

    match /joins/{id} {
      allow create: if newRequest(['uid', 'status', 'method', 'phone', 'invite', 'createdAt']);
      allow get: if true;
      // the page may cancel its own pairing when the visitor leaves
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancel';
    }

    match /public/{doc} {
      allow read: if true;
    }
  }
}
