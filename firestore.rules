rules_version = '2';
// The bot (on the phone) uses a service account and bypasses these rules.
// Visitors sign in anonymously and may only create requests and read their own.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
    function newRequest(keys) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(keys);
    }

    match /rpc/{id} {
      allow create: if newRequest(['uid', 'status', 'op', 'args', 'token', 'createdAt'])
        && request.resource.data.op is string && request.resource.data.args is map;
      allow get: if mine();
    }

    match /joins/{id} {
      allow create: if newRequest(['uid', 'status', 'method', 'phone', 'invite', 'createdAt']);
      allow get: if mine();
      // the page may cancel its own pairing when the visitor leaves
      allow update: if mine()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancel';
    }

    match /public/{doc} {
      allow read: if true;
    }
  }
}
